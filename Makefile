MAKE				= make --no-print-directory
RM					= rm -rf

# **************************************************************************** #
#                                    Comands                                   #
# **************************************************************************** #

all: $(NAME)

clean:
	@$(RM) $(BUILD_PATH)

fclean: clean
	@$(RM) $(NAME)

re: fclean all